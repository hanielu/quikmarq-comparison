# Development: ridu dev supplies .ridu/development.sqlite and local uploads.
# Plain HTTP development only. Production keeps secure cookies enabled.
RIDU_SECURE_COOKIES=false
RIDU_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generate a stable secret of at least 32 bytes for share capabilities.
# QUIKMARQ_SHARE_SECRET=

# Production: run exactly one replica with a persistent volume mounted at /data.
# RIDU_SQLITE_PATH=/data/quikmarq.sqlite
# RIDU_UPLOAD_PATH=/data/uploads
# RIDU_ALLOWED_HOSTS=your-cms-domain.example,healthcheck.railway.app
# RIDU_ALLOWED_ORIGINS=https://your-web-domain.example,https://your-cms-domain.example
# Leave proxy CIDRs unset until the immediate proxy and header sanitization are verified.
# RIDU_TRUSTED_PROXY_CIDRS=
# RIDU_READINESS_DRAIN_DELAY=-1s
# RIDU_AUTH_RATE_LIMIT=10

# Optional S3 storage: set all five credentials together to replace local uploads.
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_URL_STYLE=virtual
