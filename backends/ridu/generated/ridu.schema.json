  "plugins": [
    {
      "key": "richtext",
      "goPackage": "github.com/riducms/ridu/plugins/richtext",
      "apiVersion": 1,
      "admin": {
        "package": "@riducms/plugin-richtext",
        "export": "richTextAdminPlugin",
        "apiVersion": 1,
        "pairingVersion": 1
      },
      "fieldTypes": [
        {
          "embeddedTypes": [
            "blocks.block"
          ],
          "key": "richtext",
          "typescriptPackage": "@riducms/sdk/richtext",
          "typescriptOutput": "RichTextDocument",
          "typescriptInput": "RichTextDocumentInput",
          "goPackage": "github.com/riducms/ridu/plugins/richtext",
          "goType": "Document",
          "jsonSchema": {
            "$id": "https://riducms.com/schemas/richtext/document/1",
            "type": "object",
            "required": [
              "version",
              "root"
            ],
            "properties": {
              "version": {
                "const": 1
              },
              "root": {
                "allOf": [
                  {
                    "$ref": "#/$defs/node"
                  },
                  {
                    "properties": {
                      "type": {
                        "const": "root"
                      }
                    }
                  }
                ]
              }
            },
            "additionalProperties": false,
            "$defs": {
              "node": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "root",
                      "paragraph",
                      "heading",
                      "quote",
                      "text",
                      "linebreak",
                      "link",
                      "list",
                      "listitem",
                      "code",
                      "horizontalrule",
                      "upload",
                      "relationship",
                      "block"
                    ]
                  },
                  "version": {
                    "const": 1
                  },
                  "children": {
                    "type": "array",
                    "items": {
                      "allOf": [
                        {
                          "$ref": "#/$defs/node"
                        },
                        {
                          "properties": {
                            "type": {
                              "not": {
                                "const": "root"
                              }
                            }
                          }
                        }
                      ]
                    }
                  },
                  "fields": {
                    "type": "object"
                  },
                  "text": {
                    "type": "string"
                  },
                  "format": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  },
                  "detail": {
                    "type": "integer"
                  },
                  "mode": {
                    "enum": [
                      "normal",
                      "token",
                      "segmented"
                    ]
                  },
                  "style": {
                    "type": "string"
                  },
                  "textFormat": {
                    "type": "integer"
                  },
                  "textStyle": {
                    "type": "string"
                  },
                  "direction": {
                    "enum": [
                      "ltr",
                      "rtl",
                      null
                    ]
                  },
                  "indent": {
                    "type": "integer"
                  },
                  "tag": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  },
                  "target": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "rel": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "listType": {
                    "type": "string"
                  },
                  "start": {
                    "type": "integer"
                  },
                  "value": {
                    "type": "integer"
                  },
                  "checked": {
                    "type": "boolean"
                  },
                  "language": {
                    "type": "string"
                  },
                  "theme": {
                    "type": "string"
                  },
                  "relationTo": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "caption": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "block"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "type",
                        "version",
                        "fields"
                      ],
                      "properties": {
                        "type": {
                          "const": "block"
                        },
                        "version": {
                          "const": 1
                        },
                        "fields": {
                          "type": "object"
                        }
                      },
                      "additionalProperties": false
                    },
                    "else": {
                      "not": {
                        "required": [
                          "fields"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "enum": [
                            "root",
                            "paragraph",
                            "heading",
                            "quote",
                            "link",
                            "list",
                            "listitem",
                            "code"
                          ]
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "children"
                      ]
                    },
                    "else": {
                      "not": {
                        "required": [
                          "children"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "text"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "text"
                      ],
                      "properties": {
                        "format": {
                          "type": "integer"
                        }
                      }
                    },
                    "else": {
                      "properties": {
                        "format": {
                          "enum": [
                            "",
                            "left",
                            "center",
                            "right",
                            "justify",
                            "start",
                            "end"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "root"
                        }
                      }
                    },
                    "then": {
                      "propertyNames": {
                        "enum": [
                          "type",
                          "version",
